# ========================================
# NutriAI Beta Server Configuration
# For use with Hostinger Email
# ========================================

# Server Configuration
PORT=3001

# ========================================
# EMAIL CONFIGURATION (Hostinger)
# ========================================
# Get these from: https://hostinger.com → Email → Email Accounts → Your Email → Configure Email Client

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your-email@nutriai.com
SMTP_PASS=your-email-password

# Email sender name and address
EMAIL_FROM=NutriAI Beta <your-email@nutriai.com>

# Admin email (where you want to receive notifications)
ADMIN_EMAIL=your-email@nutriai.com

# ========================================
# BETA TESTING LINKS
# ========================================
# You'll get these from Play Console and TestFlight

# Android: Get from Play Console → Testing → Closed Testing
ANDROID_BETA_LINK=https://play.google.com/apps/testing/com.nutriai.app

# iOS: Get from App Store Connect → TestFlight → Public Link
IOS_BETA_LINK=https://testflight.apple.com/join/YOURCODE


# ========================================
# NOTES:
# ========================================
# 1. Replace 'your-email@nutriai.com' with your actual Hostinger email
# 2. Use your actual email password (NOT app password - Hostinger doesn't need it)
# 3. Make sure port 587 is open on your server
# 4. Beta links can be added later when you create the apps
